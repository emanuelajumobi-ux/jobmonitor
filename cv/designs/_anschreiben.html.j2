<!doctype html>
{% import "_teile.html.j2" as t %}
{# Anschreiben im Stil des Designs „stil“ (modern, kreativ, kompakt, akademisch) – gleicher Inhalt wie cv/anschreiben.html.j2 #}
<html lang="de"><head><meta charset="utf-8"><title>Anschreiben {{ profile.name }}</title>
<style>
@page { size: A4; margin: {{ '12mm 0 18mm' if stil == 'kreativ' else '16mm 22mm 18mm' }}; }
:root { --a: {{ akzent }}; }
* { box-sizing: border-box; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
body { margin: 0; font-size: 10.8pt; line-height: 1.45; color: #111;
  font-family: {{ '"Iowan Old Style", Charter, Georgia, serif' if stil == 'akademisch' else ('Arial, Helvetica, sans-serif' if stil == 'kompakt' else '"Helvetica Neue", "Segoe UI", Arial, sans-serif') }}; }
.inhalt { {{ 'padding: 0 22mm;' if stil == 'kreativ' else '' }} }
header.modern { border-left: 2mm solid var(--a); padding-left: 5mm; margin-bottom: 9mm; }
header.kreativ { background: var(--a); color: white; padding: 14mm 22mm 10mm; margin-bottom: 9mm; }
header.kompakt { border-bottom: 0.4mm solid var(--a); padding-bottom: 3mm; margin-bottom: 9mm; }
header.akademisch { text-align: center; margin-bottom: 9mm; }
h1 { margin: 0 0 1.5mm; font-size: {{ '24pt' if stil == 'kreativ' else '20pt' }}; color: {{ 'white' if stil == 'kreativ' else ('#111' if stil in ('kompakt', 'akademisch') else 'var(--a)') }};
     {{ 'font-weight: normal; font-variant: small-caps; letter-spacing: 1.5px;' if stil == 'akademisch' else '' }} }
header ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0 4mm; font-size: 9.2pt;
            {{ 'justify-content: center;' if stil == 'akademisch' else '' }} }
.empfaenger p { margin: 0; } .datum { text-align: right; margin: 8mm 0; }
.betreff { font-weight: 700; margin: 0 0 6mm; {{ 'color: var(--a);' if stil in ('modern', 'kreativ') else '' }} }
p { margin: 0 0 0.75em; } .name { margin-top: 2.2em; } .anlagen { font-size: 9.4pt; margin-top: 1.6em; color: #444; }
</style></head><body>
<header class="{{ stil }}"><h1>{{ profile.name }}</h1><ul>
{% for wert in [t.adresse(profile) if profile.adresse.ort else '', profile.telefon, profile.email] | select %}<li>{{ wert }}</li>{% endfor %}</ul></header>
<div class="inhalt">
<div class="empfaenger"><p>{{ firma }}</p>{% for zeile in empfaenger %}<p>{{ zeile }}</p>{% endfor %}</div>
<p class="datum">{{ ort_datum }}</p>
<p class="betreff">{{ betreff }}</p>
<p>{{ anrede }}</p>
{% for absatz in absaetze %}<p>{{ absatz }}</p>
{% endfor %}
<p>Mit freundlichen Grüßen</p>
<p class="name">{{ profile.name }}</p>
{% if anlagen %}<p class="anlagen"><b>Anlagen:</b> {{ anlagen | join(', ') }}</p>{% endif %}
</div></body></html>
